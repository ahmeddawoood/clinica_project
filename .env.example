# Copy to .env and set database passwords before starting Docker Compose.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen3:1.7b
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_COUPON_CODE=
DEEPSEEK_API_KEY=
MAIL_ENABLED=false
SMS_ENABLED=false
APP_BASE_URL=http://localhost:8082
# Enable only for a disposable local demonstration database.
DEMO_DATA_ENABLED=false

# Optional service credentials. Keep disabled until configured and verified.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# First installation only, one application instance, demo data disabled.
# After successful creation set false and remove email/password from the environment.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
